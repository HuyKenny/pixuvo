{
  "$schema": "node_modules/wrangler/config-schema.json",
  // NOTE: @astrojs/cloudflare builds dist/server/wrangler.json from this file; deploy/preview use THAT file.
  "name": "pixuvo",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // No cron trigger since 23 Nov 2026 (Workers Free: 5 crons per account, reserved for malina-cron). The /games/ and
  // language pages are frozen static shards (pixuvo-z01..z04, scripts/cloudflare-free/zmraz.py); a sync would add games
  // the shards do not have. Run "Sync and publish" manually only together with a re-freeze of the shards.
  "triggers": { "crons": [] },
  // pixuvo.com is served by this Worker; www.pixuvo.com is a zone Redirect Rule (301 → apex), so it never hits the Worker.
  "routes": [{ "pattern": "pixuvo.com", "custom_domain": true }],
  "preview_urls": false,
  "assets": { "binding": "ASSETS", "directory": "./dist/client", "html_handling": "auto-trailing-slash", "not_found_handling": "none", "run_worker_first": ["/"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "pixuvo-production", "database_id": "7191a68f-d043-434d-8166-fcca9c5b8d55", "migrations_dir": "migrations" }
  ],
  // Workers Rate Limiting API (per colo, best effort) per IP: 20 writes/min, 60 plays/min, 180 cache-missed reads/min.
  "ratelimits": [
    { "name": "RL_WRITE", "namespace_id": "71001", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_PLAY", "namespace_id": "71002", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_READ", "namespace_id": "71003", "simple": { "limit": 180, "period": 60 } }
  ],
  "vars": { "ENVIRONMENT": "production", "SITE_URL": "https://pixuvo.com", "GH_REPO": "HuyKenny/pixuvo" },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
