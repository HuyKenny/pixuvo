---
import Base from '../layouts/Base.astro';
import GameGrid from '../components/GameGrid.astro';
import CategoryBar from '../components/CategoryBar.astro';
import Hero from '../components/Hero.astro';
import StatCards from '../components/StatCards.astro';
import CategoryTiles from '../components/CategoryTiles.astro';
import FilterSidebar from '../components/FilterSidebar.astro';
import Icon from '../components/Icon.astro';
import GameOfDay from '../components/GameOfDay.astro';
import MoodTiles from '../components/MoodTiles.astro';
import { snapshot } from '../lib/snapshot';
import { SITE, categoryPath } from '../lib/site';
import { useI18n } from '../i18n';
import { loadContent, paragraphs } from '../i18n/content';
import { MIN_CATEGORY_GAMES } from '../lib/taxonomy';
import { uiIcon } from '../lib/category-icons';

const live = snapshot.categories.filter((c) => c.count >= MIN_CATEGORY_GAMES);
const BAR = ['racing', 'action', 'puzzle', 'sports', 'shooting', 'simulation', 'io', '2-player', 'car', 'football', 'adventure', 'arcade', 'stickman', 'platformer', 'strategy', 'cooking', 'match-3', 'board'];
const bar = BAR.map((s) => live.find((c) => c.slug === s)).filter((c): c is (typeof live)[number] => !!c);
const genres = live.filter((c) => c.kind === 'genre').sort((a, b) => b.count - a.count).slice(0, 10);
const TILE = ['racing', 'action', 'puzzle', 'sports', 'shooting', 'simulation', 'io', '2-player', 'car', 'football', 'arcade', 'adventure'];
const tiles = TILE.map((s) => live.find((c) => c.slug === s)).filter((c): c is (typeof live)[number] => !!c).slice(0, 8)
  .map((cat) => ({ cat, cover: snapshot.categoryPages[cat.slug]?.[0] }));
const twoPlayer = snapshot.categoryPages['2-player']?.slice(0, 12) ?? [];
const total = snapshot.published;
const i = await useI18n(Astro);
const home = (await loadContent(i.lang)).home;
const t = i.t;
const ld = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Pixuvo', url: SITE.url + '/',
    potentialAction: { '@type': 'SearchAction', target: `${SITE.url}/search/?q={search_term_string}`, 'query-input': 'required name=search_term_string' } },
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'Pixuvo', url: SITE.url + '/', logo: `${SITE.url}/logo-512.png`, email: SITE.email },
];
---
<Base title={t('home.title')} description={t('home.description', { count: i.approx(total) })} path="/" jsonLd={ld}>
  <div class="wrap">
    <CategoryBar categories={bar} />
    <div class="home-layout">
      <FilterSidebar genres={genres} />
      <div class="home-main">
        <div class="hero-row">
          <Hero total={total} picks={snapshot.home.featured.slice(0, 24)} />
          <StatCards games={total} categories={live.length} playsYesterday={snapshot.home.playsYesterday} />
        </div>
        <nav class="quickrow" aria-label={t('a11y.quickFilters')}>
          <a class="qchip" href="/2-player-games/"><span aria-hidden="true">👥</span>{t('home.quick2p')}</a>
          <a class="qchip" href="/games/#device=mobile"><span aria-hidden="true">📱</span>{t('home.quickMobile')}</a>
          <a class="qchip" href="/games/#controls=touch"><span aria-hidden="true">👆</span>{t('home.quickTouch')}</a>
          <a class="qchip" href="/games/#controls=mouse"><span aria-hidden="true">🖱️</span>{t('home.quickMouse')}</a>
          <a class="qchip" href="/games/#style=3d"><span aria-hidden="true">🧊</span>{t('home.quick3d')}</a>
          <a class="qchip" href="/games/#style=pixel"><span aria-hidden="true">👾</span>{t('home.quickPixel')}</a>
          <a class="qchip" href="/new-games/"><span aria-hidden="true">🆕</span>{t('home.quickNew')}</a>
        </nav>

        <section class="section" id="recent-section" hidden aria-labelledby="recent-h">
          <div class="section-head"><h2 id="recent-h"><img src={uiIcon('clock')} alt="" width="30" height="30" />{t('home.continue')}</h2><a href="/recently-played/">{t('nav.viewAll')} <Icon name="play" size={12} /></a></div>
          <div class="grid" id="recent-grid" role="list" aria-label={t('home.recentLabel')}></div>
        </section>

        <MoodTiles picks={snapshot.home.featured.slice(0, 36)} />

        {snapshot.home.popular.length >= 6 && (
          <section class="section" aria-labelledby="top-h">
            <div class="section-head"><h2 id="top-h"><img src={uiIcon('trophy')} alt="" width="30" height="30" />{t('home.mostPlayed')}</h2><a href="/popular-games/">{t('nav.fullRanking')}</a></div>
            <GameGrid games={snapshot.home.popular.slice(0, 12)} label={t('home.mostPlayedLabel')} ranked />
          </section>
        )}

        <section class="section sec-featured" aria-labelledby="featured-h">
          <div class="section-head"><h2 id="featured-h"><img src={uiIcon('popular')} alt="" width="30" height="30" />{snapshot.home.hasTrending ? t('home.trending') : t('home.featured')}</h2><a href={snapshot.home.hasTrending ? '/trending-games/' : '/games/'}>{t('nav.viewAll')}</a></div>
          <GameGrid games={snapshot.home.featured.slice(0, 12)} eagerCount={4} label={t('home.featuredLabel')} />
        </section>

        {snapshot.home.gameOfDay && <GameOfDay game={snapshot.home.gameOfDay} />}

        <section class="section" aria-labelledby="new-h">
          <div class="section-head"><h2 id="new-h"><span class="new-badge" data-badge={t('badge.new')} aria-hidden="true"></span>{t('home.newGames')}</h2><a href="/new-games/">{t('nav.viewAll')}</a></div>
          <GameGrid games={snapshot.home.newest.slice(0, 12)} label={t('home.newLabel')} />
        </section>
      </div>
    </div>

    <section class="section" aria-labelledby="cats-h">
      <div class="section-head"><h2 id="cats-h"><img src={uiIcon('sparkles')} alt="" width="30" height="30" />{t('home.topCategories')}</h2><a href="/categories/">{t('nav.allCategories')}</a></div>
      <CategoryTiles tiles={tiles} />
    </section>

    <div class="split">
      <section class="section" aria-labelledby="two-h">
        <div class="section-head"><h2 id="two-h"><img src={uiIcon('two')} alt="" width="30" height="30" />{t('home.twoPlayerFav')}</h2><a href={categoryPath('2-player')}>{t('nav.viewAll')}</a></div>
        <GameGrid games={twoPlayer} label={t('home.twoPlayerLabel')} wide />
      </section>
      <section class="section" aria-labelledby="rec-h">
        <div class="section-head"><h2 id="rec-h"><img src={uiIcon('star')} alt="" width="30" height="30" />{t('home.recommended')}</h2><a href="/games/">{t('nav.viewAll')}</a></div>
        <div id="rec-grid" data-fallback={JSON.stringify(snapshot.home.featured.slice(12, 24))}>
          <GameGrid games={snapshot.home.featured.slice(12, 24)} label={t('home.recommendedLabel')} wide />
        </div>
      </section>
    </div>

    {snapshot.home.sections.filter((s) => ['racing', 'action', 'puzzle', 'sports'].includes(s.slug)).map((s) => (
      <section class="section" aria-labelledby={`sec-${s.slug}`}>
        <div class="section-head"><h2 id={`sec-${s.slug}`}><img src={`/icons/cat/${s.slug}.webp`} alt="" width="30" height="30" loading="lazy" />{t('home.sectionGames', i.catGames(s.slug, s.name))}</h2><a href={categoryPath(s.slug)}>{t('home.sectionAll', { count: i.approx(s.count) })}</a></div>
        <GameGrid games={s.games.slice(0, 7)} label={t('cat.gamesLabel', i.catGames(s.slug, s.name))} row />
      </section>
    ))}
    {home && (
      <section class="seo-content" aria-labelledby="home-about-h">
        <h2 id="home-about-h">{home.h2}</h2>
        {paragraphs(home.intro).map((p) => <p>{p}</p>)}
        <p><a href="/parents/">{t('nav.parents')} →</a></p>
      </section>
    )}
  </div>
</Base>
<script>
  import { store } from '../scripts/store';
  import { cardHtml, type ClientCard } from '../scripts/cards';
  import { pageLang, tr } from '../scripts/i18n';
  const ago = (ts: number) => {
    const m = Math.max(1, Math.round((Date.now() - ts) / 60000));
    if (m < 60) return tr('c.minAgo', { n: m });
    const h = Math.round(m / 60);
    if (h < 24) return tr('c.hAgo', { n: h });
    return tr('c.daysAgo', { n: Math.round(h / 24) });
  };
  const sec = document.getElementById('recent-section');
  const grid = document.getElementById('recent-grid');
  const draw = () => {
    const items = store.recent().slice(0, 6);
    if (!sec || !grid) return;
    sec.hidden = items.length === 0;
    grid.innerHTML = items.map((g) => cardHtml(g, { note: (g.n && g.n > 1 ? tr('c.playedTimes', { n: g.n }) : '') + ago(g.at) })).join('');
    (window as unknown as { pixuvoSyncFavs?: () => void }).pixuvoSyncFavs?.();
  };
  draw();
  store.subscribe(draw);

  // "Recommended For You": games from the category of the last played game (real local history only).
  const rec = document.getElementById('rec-grid');
  const last = store.recent().find((g) => g.cat);
  if (rec && last?.cat) {
    fetch(`/api/games/?cat=${encodeURIComponent(last.cat)}&lang=${pageLang()}`)
      .then((r) => (r.ok ? r.json() : null))
      .then((raw: unknown) => {
        const data = raw as { items?: ClientCard[] } | null;
        const played = new Set(store.recent().map((x) => x.id));
        const items = (data?.items ?? []).filter((g) => !played.has(g.id)).slice(0, 12);
        if (items.length >= 12) {
          rec.innerHTML = `<div class="grid grid-wide" role="list" aria-label="${tr('c.recommendedLabel')}">${items.map((g) => cardHtml(g)).join('')}</div>`;
          (window as unknown as { pixuvoSyncFavs?: () => void }).pixuvoSyncFavs?.();
        }
      })
      .catch(() => {});
  }
</script>
