---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import BottomNav from '../components/BottomNav.astro';
import { SITE, canonical as abs } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Path for canonical; null = no canonical (noindex pages). */
  path: string | null;
  noindex?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: unknown[];
  query?: string | undefined;
  prev?: string | null;
  next?: string | null;
}
const { title, description, path, noindex = false, ogImage, ogType = 'website', jsonLd = [], query, prev, next } = Astro.props;
// Preview builds (workers.dev) are never indexable.
const preview = import.meta.env.PUBLIC_NOINDEX === '1';
const robots = noindex || preview ? 'noindex, follow' : 'index, follow, max-image-preview:large';
const fullTitle = title.includes('Pixuvo') ? title : `${title} | Pixuvo`;
const canonicalUrl = path ? abs(path) : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {prev && <link rel="prev" href={abs(prev)} />}
    {next && <link rel="next" href={abs(next)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#141a46" />
    <meta property="og:site_name" content="Pixuvo" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImage ?? `${SITE.url}/og-default.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href="/fonts/nunito-latin.v1.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://img.gamemonetize.com" />
    <link rel="preconnect" href="https://img.gamepix.com" />
    <link rel="preconnect" href="https://static.playgama.com" />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d).replace(/</g, '\\u003c')} />)}
    <slot name="head" />
  </head>
  <body>
    <Header query={query} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <BottomNav />
    <ConsentBanner />
    <script>
      import '../scripts/favorites';
      import { whenConsented } from '../scripts/consent';
      // Optional analytics loads ONLY after consent (none configured in production today).
      const src = import.meta.env.PUBLIC_ANALYTICS_SRC;
      if (src) whenConsented('analytics', () => { const s = document.createElement('script'); s.src = src; s.defer = true; document.head.appendChild(s); });
    </script>
  </body>
</html>
