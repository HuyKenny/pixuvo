---
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
interface Props { title: string; h1: string; description: string; path: string; updated: string }
const { title, h1, description, path, updated } = Astro.props;
---
<Base title={title} description={description} path={path}>
  <div class="wrap">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: h1, href: path }]} />
    <article class="doc">
      <div class="page-head"><h1>{h1}</h1><p class="lead">Last updated: {updated}</p></div>
      <slot />
    </article>
  </div>
</Base>
