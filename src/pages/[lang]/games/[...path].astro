---
export const prerender = false;
import GamePage from '../../../components/GamePage.astro';
import { loadGame } from '../../../views/loaders';
import { validLang } from '../../../views/guard';
const lang = Astro.params.lang!;
if (!validLang(lang)) return Astro.rewrite('/404/');
const res = await loadGame(Astro.params.path ?? '');
if (res.kind === 'redirect') return Astro.redirect(`/${lang}/games/${res.slug}/`, 301);
if (res.kind !== 'ok') return Astro.rewrite(`/${lang}/404/`);
---
<GamePage game={res.game} />
