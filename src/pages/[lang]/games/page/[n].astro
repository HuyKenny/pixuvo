---
export const prerender = false;
import DirectoryView from '../../../../components/DirectoryView.astro';
import { clampPage, getSetting, parseBounds } from '../../../../lib/catalog';
import { q } from '../../../../lib/server/db';
import { SITE } from '../../../../lib/site';
import { validLang } from '../../../../views/guard';
const lang = Astro.params.lang!;
if (!validLang(lang)) return Astro.rewrite('/404/');
const page = clampPage(Astro.params.n ?? '', 5000);
if (page === null) return Astro.rewrite(`/${lang}/404/`);
if (page === 1) return Astro.redirect(`/${lang}/games/`, 301);
const db = q();
const [boundsRaw, published] = await Promise.all([getSetting(db, 'dir_bounds'), getSetting(db, 'published_count')]);
const bounds = parseBounds(boundsRaw);
if (page > (bounds.length || Math.ceil(Number(published ?? 0) / SITE.pageSize))) return Astro.rewrite(`/${lang}/404/`);
---
<DirectoryView page={page} />
