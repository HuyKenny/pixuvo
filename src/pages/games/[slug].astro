---
// Top-ranked games are prerendered from the snapshot (English only); all others fall through to games/[...path].astro.
export const prerender = true;
import GamePage from '../../components/GamePage.astro';
import { gamePaths } from '../../views/paths';
import type { GameDetail } from '../../lib/types';
export function getStaticPaths() {
  return gamePaths();
}
const { game } = Astro.props as { game: GameDetail };
---
<GamePage game={game} />
