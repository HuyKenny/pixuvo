---
export const prerender = true;
import CategoryLandingView from '../../views/CategoryLandingView.astro';
import { categoryLandingPaths } from '../../views/paths';
export function getStaticPaths() {
  return categoryLandingPaths();
}
const { kind, slug } = Astro.props as { kind: 'category' | 'landing'; slug: string };
