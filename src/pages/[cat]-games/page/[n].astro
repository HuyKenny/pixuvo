---
export const prerender = false;
import CategoryView from '../../../components/CategoryView.astro';
import { categoryGames, clampPage } from '../../../lib/catalog';
import { categoriesCached, q } from '../../../lib/server/db';
import { MIN_CATEGORY_GAMES } from '../../../lib/taxonomy';
import { SITE, categoryPath } from '../../../lib/site';

const { cat, n } = Astro.params;
const page = clampPage(n ?? '', SITE.maxCategoryPages);
const db = q();
const cats = await categoriesCached(db);
const c = cats.find((x) => x.slug === cat && x.count >= MIN_CATEGORY_GAMES);
if (!c || page === null) return Astro.rewrite("/404/");
if (page === 1) return Astro.redirect(categoryPath(c.slug), 301);
const res = await categoryGames(db, c, 'featured', page);
if (page > res.pages || res.items.length === 0) return Astro.rewrite("/404/");
const parent = c.parent ? cats.find((x) => x.slug === c.parent) ?? null : null;
---
<CategoryView slug={c.slug} name={c.name} h1={`${c.name} Games`} title={`${c.name} Games – Play Free Online, No Downloads`}
  description={`Play free ${c.name.toLowerCase()} games online in your browser.`} intro={c.blurb} games={res.items} total={c.count}
  page={page} pages={res.pages} category={c} categories={cats} parent={parent} />
