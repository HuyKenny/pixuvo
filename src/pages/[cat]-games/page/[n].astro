---
export const prerender = false;
import CategoryPageN from '../../../views/CategoryPageN.astro';
import { loadCategoryPage } from '../../../views/loaders';
const r = await loadCategoryPage(Astro.params.cat ?? '', Astro.params.n ?? '');
if (r.kind === 'missing') return Astro.rewrite('/404/');
if (r.kind === 'redirect') return Astro.redirect(r.to, 301);
---
<CategoryPageN data={r.data} />
