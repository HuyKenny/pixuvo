---
import Logo from './Logo.astro';
import { SITE } from '../lib/site';
const year = new Date().getUTCFullYear();
---
<footer class="site-footer">
  <div class="wrap footer-row">
    <div class="footer-brand"><Logo size={30} /><span>Play more games. Every day.</span></div>
    <nav aria-label="Footer">
      <a href="/">Home</a><a href="/categories/">Categories</a><a href="/new-games/">New Games</a><a href="/popular-games/">Popular</a><a href="/2-player-games/">2 Player</a><a href="/games/">All Games</a>
    </nav>
  </div>
  <div class="wrap footer-fine">
    <nav aria-label="Legal"><a href="/parents/">For parents</a><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/privacy/">Privacy</a><a href="/cookies/">Cookies</a><a href="/terms/">Terms</a><a href="/copyright/">Copyright</a><button type="button" class="link-btn footer-link" data-consent-open>Privacy choices</button></nav>
    <span>© {year} Pixuvo · Games by their developers and partners · <a href={`mailto:${SITE.email}`}>{SITE.email}</a></span>
  </div>
</footer>
