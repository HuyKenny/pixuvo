---
import { canonical } from '../lib/site';
interface Props { items: Array<{ name: string; href?: string }> }
const { items } = Astro.props;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((it, i) => ({ '@type': 'ListItem', position: i + 1, name: it.name, ...(it.href ? { item: canonical(it.href) } : {}) })),
};
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((it, i) => <li>{it.href && i < items.length - 1 ? <a href={it.href}>{it.name}</a> : <span aria-current="page">{it.name}</span>}</li>)}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')} />
