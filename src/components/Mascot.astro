---
/** Pixu — the Pixuvo mascot driving a kart. Original artwork (inline SVG, no external assets). */
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 0 420 340" role="img" aria-label="Pixu, the Pixuvo mascot, racing a kart" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="px-body" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#9b6bff" /><stop offset="1" stop-color="#5a28e0" /></linearGradient>
    <linearGradient id="px-kart" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ff5d5d" /><stop offset="1" stop-color="#d42a4a" /></linearGradient>
    <linearGradient id="px-coin" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffe066" /><stop offset="1" stop-color="#f5a300" /></linearGradient>
    <radialGradient id="px-glow" cx="0.5" cy="0.5" r="0.5"><stop offset="0" stop-color="#ffffff" stop-opacity="0.55" /><stop offset="1" stop-color="#ffffff" stop-opacity="0" /></radialGradient>
  </defs>
  <!-- glow + speed lines -->
  <circle cx="230" cy="170" r="150" fill="url(#px-glow)" />
  <g stroke="#ffffff" stroke-opacity="0.7" stroke-width="7" stroke-linecap="round">
    <path d="M18 228h70" /><path d="M4 258h96" /><path d="M30 288h60" />
  </g>
  <!-- coins -->
  <g>
    <circle cx="358" cy="72" r="24" fill="url(#px-coin)" stroke="#c97b00" stroke-width="4" />
    <text x="358" y="82" text-anchor="middle" font-family="Nunito, sans-serif" font-weight="900" font-size="28" fill="#c97b00">P</text>
    <circle cx="392" cy="150" r="16" fill="url(#px-coin)" stroke="#c97b00" stroke-width="3" />
    <circle cx="70" cy="70" r="14" fill="url(#px-coin)" stroke="#c97b00" stroke-width="3" />
  </g>
  <!-- stars -->
  <g fill="#ffe066">
    <path d="M110 22l7 15 16 2-12 11 3 16-14-8-14 8 3-16-12-11 16-2z" />
    <path d="M312 18l5 10 11 1-8 8 2 11-10-5-10 5 2-11-8-8 11-1z" />
  </g>
  <!-- kart body -->
  <g>
    <path d="M96 252c0-26 20-44 46-44h150c30 0 52 18 60 40l8 22c3 9-4 18-13 18H112c-9 0-16-7-16-16z" fill="url(#px-kart)" stroke="#8c1430" stroke-width="5" />
    <path d="M150 226h110" stroke="#ffd2d2" stroke-width="6" stroke-linecap="round" opacity="0.7" />
    <rect x="300" y="224" width="44" height="18" rx="6" fill="#ffe066" stroke="#8c1430" stroke-width="4" />
    <text x="322" y="239" text-anchor="middle" font-family="Nunito, sans-serif" font-weight="900" font-size="14" fill="#8c1430">1</text>
    <!-- wheels -->
    <g stroke="#1b1f3b" stroke-width="5">
      <circle cx="150" cy="292" r="30" fill="#2b2f55" />
      <circle cx="150" cy="292" r="12" fill="#c9cdf0" />
      <circle cx="318" cy="292" r="30" fill="#2b2f55" />
      <circle cx="318" cy="292" r="12" fill="#c9cdf0" />
    </g>
  </g>
  <!-- Pixu: rounded pixel creature -->
  <g>
    <rect x="160" y="96" width="120" height="124" rx="34" fill="url(#px-body)" stroke="#3d1a9e" stroke-width="5" />
    <!-- antenna pixel (teal, like the logo) -->
    <rect x="252" y="66" width="24" height="24" rx="7" fill="#2dd4bf" stroke="#0b7a68" stroke-width="4" />
    <path d="M252 96l8-10" stroke="#3d1a9e" stroke-width="5" stroke-linecap="round" />
    <!-- eyes -->
    <ellipse cx="200" cy="150" rx="17" ry="20" fill="#fff" />
    <ellipse cx="244" cy="150" rx="17" ry="20" fill="#fff" />
    <circle cx="205" cy="154" r="9" fill="#1b1f3b" />
    <circle cx="249" cy="154" r="9" fill="#1b1f3b" />
    <circle cx="208" cy="150" r="3" fill="#fff" />
    <circle cx="252" cy="150" r="3" fill="#fff" />
    <!-- smile + cheeks -->
    <path d="M204 184c10 12 28 12 38 0" stroke="#1b1f3b" stroke-width="6" stroke-linecap="round" fill="none" />
    <circle cx="186" cy="182" r="7" fill="#ff8fb3" opacity="0.8" />
    <circle cx="260" cy="182" r="7" fill="#ff8fb3" opacity="0.8" />
    <!-- arms holding a gamepad steering wheel -->
    <path d="M168 200c-14 6-18 18-12 26" stroke="#3d1a9e" stroke-width="12" stroke-linecap="round" fill="none" />
    <path d="M272 200c14 6 18 18 12 26" stroke="#3d1a9e" stroke-width="12" stroke-linecap="round" fill="none" />
    <rect x="176" y="208" width="88" height="34" rx="17" fill="#1f2760" stroke="#0d1235" stroke-width="4" />
    <path d="M196 225h14M203 218v14" stroke="#2dd4bf" stroke-width="5" stroke-linecap="round" />
    <circle cx="238" cy="221" r="5" fill="#ff5d5d" /><circle cx="250" cy="229" r="5" fill="#ffe066" />
  </g>
</svg>
