---
/**
 * Popular / Trending are computed from real Pixuvo play counts (scripts/metrics.ts):
 *  popular  = most play clicks in the last 7 days (min 5 plays)
 *  trending = biggest rise in plays: last 3 days vs. the 7 days before (min 5 plays)
 * Until enough data exists the page says so, shows "Featured games" instead and is noindex.
 */
import Base from '../layouts/Base.astro';
import GameGrid from './GameGrid.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { gamesByIds, getSetting, topGames } from '../lib/catalog';
import { q } from '../lib/server/db';
interface Props { kind: 'popular' | 'trending' }
const { kind } = Astro.props;
import { useI18n } from '../i18n';
const { t } = await useI18n(Astro);
const db = q();
let ids: number[] = [];
try {
  const raw = await getSetting(db, `list:${kind}`);
  const arr = raw ? (JSON.parse(raw) as unknown) : [];
  ids = Array.isArray(arr) ? arr.filter((x): x is number => Number.isInteger(x)) : [];
} catch {
  ids = [];
}
const games = ids.length >= 12 ? await gamesByIds(db, ids.slice(0, 90)) : [];
const hasData = games.length >= 12;
const fallback = hasData ? [] : await topGames(db, 'featured', 48);
const name = kind === 'popular' ? t('list.popularName') : t('list.trendingName');
const path = `/${kind}-games/`;
---
<Base title={kind === 'popular' ? t('list.popularTitle') : t('list.trendingTitle')} description={kind === 'popular' ? t('list.popularDescription') : t('list.trendingDescription')} path={path} noindex={!hasData}>
  <div class="wrap">
    <Breadcrumbs items={[{ name: t('nav.home'), href: '/' }, { name, href: path }]} />
    <div class="page-head">
      <h1>{name}</h1>
      <p class="lead">{kind === 'popular' ? t('list.popularLead') : t('list.trendingLead')}</p>
    </div>
    {hasData ? <GameGrid games={games} eagerCount={7} label={name} ranked={kind === 'popular'} /> : (
      <>
        <div class="empty-state"><strong>{t('list.noDataTitle')}</strong>{t('list.noDataText')}</div>
        <div class="section"><div class="section-head"><h2>{t('home.featured')}</h2></div><GameGrid games={fallback} label={t('home.featuredLabel')} /></div>
      </>
    )}
  </div>
</Base>
