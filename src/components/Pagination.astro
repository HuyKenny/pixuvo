---
import { useI18n } from '../i18n';
import { pagerItems } from '../lib/pager';
interface Props { page: number; pages: number; href: (p: number) => string; label?: string }
const { t } = await useI18n(Astro);
const { page, pages, href, label = t('a11y.pagination') } = Astro.props;
const nums = pagerItems(page, pages);
---
{pages > 1 && (
  <nav aria-label={label}>
    <ul class="pagination">
      {page > 1 && <li><a href={href(page - 1)} rel="prev">{t('pager.previous')}</a></li>}
      {nums.map((n) => n === 'gap'
        ? <li><span class="gap" aria-hidden="true">…</span></li>
        : <li>{n === page ? <span aria-current="page">{n}</span> : <a href={href(n)}>{n}</a>}</li>)}
      {page < pages && <li><a href={href(page + 1)} rel="next">{t('pager.next')}</a></li>}
    </ul>
  </nav>
)}
