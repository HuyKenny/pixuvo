---
/**
 * Consent layer. Pixuvo pages run Google Analytics only with consent and NO advertising;
 * the banner opens automatically while an optional category is on and no choice exists
 * (PUBLIC_CONSENT_CATEGORIES overrides at build time). Until then "Privacy choices" in the
 * footer shows the state. Optional scripts must be loaded through
 * `whenConsented()` in src/scripts/consent.ts — never directly.
 */
import { SITE } from '../lib/site';
// Build-time override (tests); otherwise analytics is offered whenever a GA4 id is configured.
const raw = import.meta.env.PUBLIC_CONSENT_CATEGORIES ?? (SITE.ga4 ? 'analytics' : '');
const active = raw.split(',').map((s: string) => s.trim()).filter(Boolean);
const analytics = active.includes('analytics');
const ads = active.includes('ads');
---
<section class="consent" id="consent" hidden aria-labelledby="consent-title" data-consent data-active={active.join(',')} role="dialog" aria-modal="false">
  <p class="consent-text">
    <strong id="consent-title">🍪 Privacy choices</strong>
    {active.length > 0
      ? <>May we count which games are played? (Google Analytics, no ads.) Your favorites stay on this device. <a href="/cookies/">More</a> · <button type="button" class="link-btn consent-settings" data-consent-settings>Settings</button></>
      : <>Pixuvo runs no analytics or ads on its pages. Favorites and history stay on this device; games come from partners who handle their own ads. <a href="/cookies/">More</a></>}
  </p>
  <div class="row">
    {active.length > 0 && <button type="button" class="btn btn-ghost" data-consent-action="reject">No thanks</button>}
    {active.length > 0 && <button type="button" class="btn btn-primary" data-consent-action="accept">OK</button>}
    {active.length === 0 && <button type="button" class="btn btn-primary" data-consent-action="close">Close</button>}
  </div>
  {active.length > 0 && (
    <details data-consent-details>
      <summary class="sr-only">Settings</summary>
      <label><input type="checkbox" checked disabled /> <span><strong>Necessary</strong> — favorites, history and this choice, stored only in your browser.</span></label>
      <label><input type="checkbox" name="analytics" disabled={!analytics} /> <span><strong>Analytics</strong> — Google Analytics counts visits and which games are played. No ads, no profiles, no Google signals.</span></label>
      {ads && <label><input type="checkbox" name="ads" /> <span><strong>Advertising on Pixuvo pages</strong> — ads around the game area.</span></label>}
      <p class="consent-fine">A game loads from our partner when you open its page; partners show their own ads inside games and handle their own consent.</p>
      <button type="button" class="btn btn-ghost" data-consent-action="save">Save choices</button>
    </details>
  )}
</section>
<script>
  import '../scripts/consent';
</script>
