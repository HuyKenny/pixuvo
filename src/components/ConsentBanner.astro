---
/**
 * Consent layer. Pixuvo pages run Google Analytics only with consent and NO advertising;
 * the banner opens automatically while an optional category is on and no choice exists
 * (PUBLIC_CONSENT_CATEGORIES overrides at build time). Until then "Privacy choices" in the
 * footer shows the state. Optional scripts must be loaded through
 * `whenConsented()` in src/scripts/consent.ts — never directly.
 */
import { SITE } from '../lib/site';
import { useI18n } from '../i18n';
const { t } = await useI18n(Astro);
// Build-time override (tests); otherwise analytics is offered whenever a GA4 id is configured.
const raw = import.meta.env.PUBLIC_CONSENT_CATEGORIES ?? (SITE.ga4 ? 'analytics' : '');
const active = raw.split(',').map((s: string) => s.trim()).filter(Boolean);
const analytics = active.includes('analytics');
const ads = active.includes('ads');
---
<section class="consent" id="consent" hidden aria-labelledby="consent-title" data-consent data-active={active.join(',')} role="dialog" aria-modal="false">
  <p class="consent-text">
    <strong id="consent-title">{t('consent.title')}</strong>
    {active.length > 0
      ? <>{t('consent.ask')} <a href="/cookies/">{t('consent.details')}</a> · <button type="button" class="link-btn consent-settings" data-consent-settings>{t('consent.settings')}</button></>
      : <>{t('consent.noTracking')} <a href="/cookies/">{t('consent.more')}</a></>}
  </p>
  <div class="row">
    {active.length > 0 && <button type="button" class="btn btn-ghost" data-consent-action="reject">{t('consent.reject')}</button>}
    {active.length > 0 && <button type="button" class="btn btn-primary" data-consent-action="accept">{t('consent.accept')}</button>}
    {active.length === 0 && <button type="button" class="btn btn-primary" data-consent-action="close">{t('consent.close')}</button>}
  </div>
  {active.length > 0 && (
    <details data-consent-details>
      <summary class="sr-only">{t('consent.settings')}</summary>
      <label><input type="checkbox" checked disabled /> <span><strong>{t('consent.necessary')}</strong> {t('consent.necessaryText')}</span></label>
      <label><input type="checkbox" name="analytics" disabled={!analytics} /> <span><strong>{t('consent.analytics')}</strong> {t('consent.analyticsText')}</span></label>
      {ads && <label><input type="checkbox" name="ads" /> <span><strong>{t('consent.ads')}</strong> {t('consent.adsText')}</span></label>}
      <p class="consent-fine">{t('consent.partner')}</p>
      <button type="button" class="btn btn-ghost" data-consent-action="save">{t('consent.save')}</button>
    </details>
  )}
</section>
<script>
  import '../scripts/consent';
</script>
