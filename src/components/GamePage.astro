---
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import GameGrid from './GameGrid.astro';
import Icon from './Icon.astro';
import AdSlot from './AdSlot.astro';
import Tag from './Tag.astro';
import ControlsVisual from './ControlsVisual.astro';
import RecommendedList from './RecommendedList.astro';
import type { GameDetail } from '../lib/types';
import { canonical, categoryPath, gamePath } from '../lib/site';
import { useI18n } from '../i18n';
import { truncate } from '../lib/text';
import { parseControls } from '../lib/controls';
import { categoryIcon } from '../lib/category-icons';
import { MIN_PLAYS_SHOWN, playsLabel } from '../lib/plays';

interface Props { game: GameDetail }
const { game: g } = Astro.props;
const i = await useI18n(Astro);
const t = i.t;
// Publisher texts are English and are shown only on English pages. Other languages get a short intro written
// from known facts (category, players, devices), and the page stays noindex (templated text = thin duplicates).
const localised = i.lang !== 'en';
const description = localised ? '' : g.description;
const instructions = localised ? '' : g.instructions;
const catName = (c: { slug: string; name: string }) => i.cat(c.slug, c.name);
const path = gamePath(g.slug);
const cat = g.primaryCategory;
const crumbs = [{ name: t('nav.home'), href: '/' }, ...(cat ? [{ name: t('game.categoryGames', i.catGames(cat.slug, catName(cat))), href: categoryPath(cat.slug) }] : [{ name: t('nav.allGames'), href: '/games/' }]), { name: g.title, href: path }];
const tail = t('game.tail', { title: g.title });
const short = description ? truncate(description.replace(/\s+/g, ' ').trim(), 150) : '';
// Partner blurbs can be a few words ("A one-touch race, fly, crash"): pad them to a useful snippet.
const desc = short.length >= 70 ? short : short ? truncate(`${short.replace(/[.!]?$/, '.')} ${tail}`, 158) : `${tail} ${t('game.tailNoDesc')}`;
const portrait = g.orientation === 'portrait' || (!!g.width && !!g.height && g.height > g.width * 1.1);
// How the stage is sized on phones: portrait = full screen height, any = tall adaptive frame, landscape = 16:9.
const fit = portrait ? 'portrait' : g.orientation === 'any' ? 'any' : 'landscape';
const votes = g.ratingUp + g.ratingDown;
const liked = votes >= 5 ? Math.round((g.ratingUp / votes) * 100) : null; // shown only with ≥ 5 real votes
const players = g.players ? (g.players >= 2 ? t('game.playersN', { n: g.players }) : t('game.players1')) : null;
const styleLabel = g.visualStyle === 'pixel' ? t('game.styleRetro') : g.visualStyle?.toUpperCase() ?? null;
const controls = parseControls(g.instructions);
const tones = ['violet', 'blue', 'teal', 'orange', 'pink', 'green'] as const;
const sideList = g.related.slice(0, 5);
const moreCat = g.related.slice(5, 11);
const similar = g.related.slice(11, 17);
const topCat = g.related.slice(17, 23);
const devices = g.mobile ? t('game.devicesAll') : t('game.devicesDesktop');
// "Good to know": questions answered ONLY from real data (nothing is asked when the answer is unknown).
const lower = (s: string) => s.toLocaleLowerCase(i.tag);
const keyName = (r: (typeof controls)[number]) => r.device === 'keys' ? (r.keys.join('') === '↑←↓→' ? t('game.keyArrows') : r.keys.join('') === 'WASD' ? 'W A S D' : r.keys.join(' ')) : r.device === 'mouse' ? t('game.keyMouse', { gesture: lower(t(`ctl.${r.gesture ?? 'Click'}`)) }) : t('game.keyTouch', { gesture: lower(t(`ctl.${r.gesture ?? 'Tap'}`)) });
const controlText = controls.slice(0, 4).map((r) => (r.action ? t('game.keyTo', { key: keyName(r), action: lower(t(`ctl.${r.action}`)) }) : keyName(r))).join(', ');
const faq: Array<{ q: string; a: string }> = [
  { q: t('game.faqFreeQ', { title: g.title }), a: t('game.faqFreeA', { title: g.title }) + (g.inAppPurchases ? ` ${t('game.faqFreeIap')}` : '') },
  ...(g.mobile ? [{ q: t('game.faqMobileQ', { title: g.title }), a: t('game.faqMobileA') }] : []),
  ...(g.players ? [{ q: t('game.faqPlayersQ'), a: g.players >= 2 ? t('game.faqPlayersMulti', { title: g.title, n: String(g.players) }) : t('game.faqPlayersSingle', { title: g.title }) }] : []),
  ...(controlText ? [{ q: t('game.faqControlsQ', { title: g.title }), a: t('game.faqControlsA', { controls: controlText }) }] : []),
  ...(g.categories.length ? [{ q: t('game.faqKindQ', { title: g.title }), a: t('game.faqKindA', { cats: g.categories.slice(0, 3).map(catName).join(', ') }) }] : []),
];
const intro = [
  cat ? t('game.introKind', { title: g.title, ...i.catGames(cat.slug, catName(cat)) }) : '',
  t('game.introFree'),
  g.players ? (g.players >= 2 ? t('game.introPlayersN', { n: g.players }) : t('game.introPlayers1')) : '',
  g.mobile ? t('game.introDevicesAll') : t('game.introDesktop'),
  controls.length ? t('game.introControls') : '',
].filter(Boolean).join(['ja', 'zh-hans', 'zh-hant'].includes(i.lang) ? '' : ' '); // CJK sentences are not separated by spaces
const ld = [{
  '@context': 'https://schema.org', '@type': 'VideoGame', name: g.title, url: canonical(path), image: g.thumb,
  ...(description ? { description: truncate(description, 500) } : {}),
  inLanguage: i.tag,
  genre: g.categories.filter((c) => c.slug !== '2-player' && c.slug !== 'multiplayer').map((c) => c.name).slice(0, 4),
  gamePlatform: 'Web browser', applicationCategory: 'Game', operatingSystem: 'Any',
  playMode: g.players && g.players >= 2 ? 'MultiPlayer' : g.players === 1 ? 'SinglePlayer' : undefined,
  ...(g.releaseDate ? { datePublished: g.releaseDate } : {}),
  offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD' },
}, ...(faq.length >= 3 ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : [])];
// The game starts on page open: warm up the partner's frame host.
const FRAME_HOST: Record<string, string> = { GameMonetize: 'https://html5.gamemonetize.co', GamePix: 'https://play.gamepix.com', Playgama: 'https://playgama.com' };
const frameHost = g.providerName ? FRAME_HOST[g.providerName] : undefined;
const data = { id: g.id, slug: g.slug, title: g.title, thumb: g.thumb, portrait, fit, ...(cat ? { cat: cat.slug } : {}) };
---
<Base title={t('game.title', { title: g.title })} description={desc} path={path} ogImage={g.thumb} jsonLd={ld} noindex={localised} alternates={['en']} ga={{ page_type: 'game', game_slug: g.slug, game_title: g.title.slice(0, 90), ...(cat ? { game_category: cat.slug } : {}), ...(g.providerName ? { provider: g.providerName } : {}) }}>
  {frameHost && <link slot="head" rel="preconnect" href={frameHost} />}
  <div class="wrap game-page">
    <Breadcrumbs items={crumbs} />
    <div class="game-layout">
      <div class="game-main">
        <header class="game-head">
          <img class="game-icon" src={g.thumb} alt="" width="76" height="76" referrerpolicy="no-referrer" />
          <div class="game-head-text">
            <h1>{g.title}</h1>
            <p class="game-rating">
              {liked !== null
                ? <><span class="liked-ico" aria-hidden="true">👍</span><strong>{t('game.liked', { p: String(liked) })}</strong> <span>{t('game.votes', { n: votes })}</span></>
                : <span class="muted">{t('game.notRated')}</span>}
              {(g.plays7d ?? 0) >= MIN_PLAYS_SHOWN && <span class="game-plays">{t('game.playedWeek', { n: playsLabel(g.plays7d!) })}</span>}
            </p>
          </div>
          <div class="game-tags">{g.categories.slice(0, 3).map((c, idx) => <Tag href={categoryPath(c.slug)} tone={tones[idx % tones.length]!}>{catName(c)}</Tag>)}{g.mobile && <Tag tone="green">{t('game.mobile')}</Tag>}{g.inAppPurchases && <Tag tone="orange">{t('game.iap')}</Tag>}</div>
        </header>

        <div class:list={['stage', { portrait }]} id="stage" data-fit={fit} data-game={JSON.stringify(data)}>
          <div class="stage-poster" data-poster>
            <img class="bg" src={g.thumb} alt="" width="320" height="240" referrerpolicy="no-referrer" />
            <div class="inner">
              <img class="cover" src={g.thumb} alt={t('game.cover', { title: g.title })} width="320" height="240" fetchpriority="high" referrerpolicy="no-referrer" />
              <button type="button" class="play-btn" data-play hidden><Icon name="play" /> {t('game.playNow')}</button>
              <p class="stage-msg" data-stage-msg><span class="loader" aria-hidden="true"></span>{t('game.loading')}</p>
              <noscript><p class="stage-msg">{t('game.noJs')}</p></noscript>
            </div>
          </div>
        </div>
        <button type="button" class="btn btn-primary exit-expanded" data-exit-expanded><Icon name="x" size={22} /> {t('game.exit')}</button>
        {fit === 'landscape' && (
          <p class="rotate-hint" data-rotate-hint hidden>
            <span class="rotate-ico" aria-hidden="true">📱↻</span>
            <span set:html={t('game.rotate', { fullscreen: `<strong>${t('game.fullscreen')}</strong>` })} />
            <button type="button" class="icon-btn" data-rotate-close aria-label={t('game.hideTip')}><Icon name="x" size={18} /></button>
          </p>
        )}
        <div class="game-actions" aria-label={t('a11y.gameActions')}>
          <button type="button" class="action-btn action-main" data-fullscreen><Icon name="maximize" size={20} /> <span>{t('game.fullscreen')}</span></button>
          <button type="button" class="action-btn vote-btn" data-vote="1" aria-pressed="false"><Icon name="up" size={20} /> <span>{t('game.like')}</span></button>
          <button type="button" class="action-btn vote-btn" data-vote="-1" aria-pressed="false"><Icon name="down" size={20} /> <span>{t('game.dislike')}</span></button>
          <button type="button" class="action-btn" data-fav={g.id} data-slug={g.slug} data-title={g.title} data-thumb={g.thumb} aria-pressed="false" data-fav-label="static"><Icon name="heart" size={20} /> <span>{t('game.favorite')}</span></button>
          <button type="button" class="action-btn" data-share><Icon name="share" size={20} /> <span>{t('game.share')}</span></button>
          <button type="button" class="action-btn" data-report-open><Icon name="flag" size={20} /> <span>{t('game.report')}</span></button>
        </div>
        <p class="form-status quick-status" data-rate-status aria-live="polite"></p>
        <div data-turnstile-slot data-quick-ts></div>
        <p class="note" data-share-status aria-live="polite"></p>
        {sideList.length > 0 && (
          <nav class="playnext" aria-label={t('game.playNext')}>
            <h2 class="playnext-h">{t('game.playNext')}</h2>
            <div class="playnext-row">
              {g.related.slice(0, 8).map((r) => (
                <a href={`/games/${r.slug}/`} class="playnext-card">
                  <img src={r.thumb} alt="" width="160" height="120" loading="lazy" referrerpolicy="no-referrer" />
                  <span>{r.title}</span>
                </a>
              ))}
            </div>
          </nav>
        )}

        <section class="panel" aria-labelledby="about-h">
          <h2 id="about-h"><span class="panel-ico" aria-hidden="true">📄</span>{t('game.about', { title: g.title })}</h2>
          {localised ? <div class="prose"><p>{intro}</p></div> : description ? <div class="prose"><p>{description}</p></div> : <p class="note">{t('game.noDescription')}</p>}
          <div class="tag-row">
            {g.categories.map((c, idx) => <Tag href={categoryPath(c.slug)} tone={tones[idx % tones.length]!} small>{catName(c)}</Tag>)}
            {styleLabel && <Tag tone="orange" small>{styleLabel}</Tag>}
            {g.inAppPurchases && <Tag tone="orange" small>{t('game.iap')}</Tag>}
            {g.controls.map((c) => <Tag tone="pink" small>{t(`c.${c}`)}</Tag>)}
          </div>
        </section>

        {(instructions || controls.length > 0) && (
          <div class="howto-row">
            {instructions && (
              <section class="panel" aria-labelledby="howto-h">
                <h2 id="howto-h"><span class="panel-ico" aria-hidden="true">🎮</span>{t('game.howTo')}</h2>
                <div class="prose"><p>{instructions}</p></div>
              </section>
            )}
            {controls.length > 0 && (
              <section class="panel" aria-labelledby="controls-h">
                <h2 id="controls-h"><span class="panel-ico" aria-hidden="true">⚙️</span>{t('game.controls')}</h2>
                <ControlsVisual rows={controls} />
              </section>
            )}
          </div>
        )}
        {faq.length >= 3 && (
          <section class="panel faq" aria-labelledby="faq-h">
            <h2 id="faq-h"><span class="panel-ico" aria-hidden="true">💡</span>{t('game.goodToKnow')}</h2>
            {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
          </section>
        )}
      </div>

      <aside class="game-side">
        {sideList.length > 0 && (
          <section class="panel" aria-labelledby="recg-h">
            <div class="panel-head"><h2 id="recg-h">{t('game.recommended')}</h2>{cat && <a href={categoryPath(cat.slug)}>{t('nav.seeAll')}</a>}</div>
            <RecommendedList games={sideList} />
          </section>
        )}
        <section class="panel" aria-labelledby="facts-h">
          <h2 id="facts-h"><span class="panel-ico" aria-hidden="true">ℹ️</span>{t('game.details')}</h2>
          <dl class="facts">
            {cat && (<><dt>{t('game.fCategory')}</dt><dd><a href={categoryPath(cat.slug)}><img src={categoryIcon(cat.slug)} alt="" width="20" height="20" />{catName(cat)}</a></dd></>)}
            {players && (<><dt>{t('game.fPlayers')}</dt><dd>{players}</dd></>)}
            {g.releaseDate && (<><dt>{t('game.fReleased')}</dt><dd>{i.date(g.releaseDate)}</dd></>)}
            <dt>{t('game.fPlatform')}</dt><dd>{t('game.fPlatformValue')}</dd>
            {g.technology && (<><dt>{t('game.fTech')}</dt><dd>{g.technology === 'html5' ? 'HTML5' : g.technology === 'webgl' ? 'WebGL' : 'Unity'}</dd></>)}
            <dt>{t('game.fDevices')}</dt><dd>{devices}{!g.mobile && <span class="note"> {t('game.mobileNotStated')}</span>}</dd>
            {g.inAppPurchases && (<><dt>{t('game.fPurchases')}</dt><dd>{t('game.purchasesValue')}</dd></>)}
            {styleLabel && (<><dt>{t('game.fStyle')}</dt><dd>{styleLabel}</dd></>)}
            <dt>{t('game.fAdded')}</dt><dd>{i.date(g.addedAt)}</dd>
            {g.providerName && (<><dt>{t('game.fProvider')}</dt><dd>{g.providerName}</dd></>)}
          </dl>
        </section>
        <section class="panel" aria-labelledby="rate-h">
          <h2 id="rate-h">{t('game.didYouLike')}</h2>
          <div class="rating" data-rating data-up={g.ratingUp} data-down={g.ratingDown}>
            <button type="button" class="action-btn" data-vote="1" aria-pressed="false"><Icon name="up" size={20} /> <span>{t('game.like')}</span></button>
            <button type="button" class="action-btn" data-vote="-1" aria-pressed="false"><Icon name="down" size={20} /> <span>{t('game.dislike')}</span></button>
          </div>
          <p class="score" data-score>{votes > 0 ? t('game.scoreLine', { p: String(Math.round((g.ratingUp / votes) * 100)), n: votes }) : t('game.notRatedFirst')}</p>
          <div data-turnstile-slot></div>
          <p class="form-status" data-rate-status aria-live="polite"></p>
        </section>
        <AdSlot slot="game-sidebar" />
      </aside>
    </div>

    {moreCat.length > 0 && cat && (
      <section class="section strip" aria-labelledby="more-h">
        <div class="section-head"><h2 id="more-h"><img src={categoryIcon(cat.slug)} alt="" width="30" height="30" loading="lazy" />{t('game.moreCat', i.catGames(cat.slug, catName(cat)))}</h2><a href={categoryPath(cat.slug)}>{t('nav.seeAll')}</a></div>
        <GameGrid games={moreCat} label={t('game.moreCatLabel', i.catGames(cat.slug, catName(cat)))} />
      </section>
    )}
    {(similar.length > 0 || topCat.length > 0) && (
      <div class="split">
        {similar.length > 0 && (
          <section class="section" aria-labelledby="sim-h">
            <div class="section-head"><h2 id="sim-h"><img src="/icons/cat/ui-controller.webp" alt="" width="28" height="28" loading="lazy" />{t('game.similar')}</h2></div>
            <GameGrid games={similar} label={t('game.similar')} compact />
          </section>
        )}
        {topCat.length > 0 && cat && (
          <section class="section" aria-labelledby="top-h">
            <div class="section-head"><h2 id="top-h"><img src="/icons/cat/ui-popular.webp" alt="" width="28" height="28" loading="lazy" />{t('game.topCat', i.catGames(cat.slug, catName(cat)))}</h2><a href={categoryPath(cat.slug)}>{t('nav.seeAll')}</a></div>
            <GameGrid games={topCat} label={t('game.topCatLabel', i.catGames(cat.slug, catName(cat)))} compact />
          </section>
        )}
      </div>
    )}
  </div>

  <dialog id="report-dialog" aria-labelledby="report-h">
    <form method="dialog" data-report-form>
      <h2 id="report-h">{t('report.title')}</h2>
      <p class="note" style="margin:0">{t('report.intro', { title: g.title })}</p>
      <label class="field">{t('report.what')}
        <select name="reason" required>
          <option value="not_loading">{t('report.notLoading')}</option>
          <option value="broken_controls">{t('report.controls')}</option>
          <option value="inappropriate">{t('report.inappropriate')}</option>
          <option value="copyright">{t('report.copyright')}</option>
          <option value="other">{t('report.other')}</option>
        </select>
      </label>
      <label class="field">{t('report.details')}
        <textarea name="message" maxlength="1000" placeholder={t('report.placeholder')}></textarea>
      </label>
      <div data-turnstile-slot></div>
      <p class="form-status" data-report-status aria-live="polite"></p>
      <div style="display:flex;gap:8px;justify-content:flex-end">
        <button type="button" class="btn btn-ghost" data-report-cancel>{t('report.cancel')}</button>
        <button type="submit" class="btn btn-primary" value="send">{t('report.send')}</button>
      </div>
      <p class="note" style="margin:0">{t('report.legal')} <a href="/copyright/">{t('nav.copyright')}</a>.</p>
    </form>
  </dialog>
</Base>
<script>
  import '../scripts/player';
</script>
