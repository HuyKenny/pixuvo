---
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import GameGrid from './GameGrid.astro';
import Icon from './Icon.astro';
import AdSlot from './AdSlot.astro';
import Tag from './Tag.astro';
import ControlsVisual from './ControlsVisual.astro';
import RecommendedList from './RecommendedList.astro';
import type { GameDetail } from '../lib/types';
import { canonical, categoryPath, gamePath } from '../lib/site';
import { fmtDate, plural } from '../lib/format';
import { truncate } from '../lib/text';
import { parseControls } from '../lib/controls';
import { categoryIcon } from '../lib/category-icons';

interface Props { game: GameDetail }
const { game: g } = Astro.props;
const path = gamePath(g.slug);
const cat = g.primaryCategory;
const crumbs = [{ name: 'Home', href: '/' }, ...(cat ? [{ name: `${cat.name} Games`, href: categoryPath(cat.slug) }] : [{ name: 'All games', href: '/games/' }]), { name: g.title, href: path }];
const desc = g.description ? truncate(g.description.replace(/\s+/g, ' '), 150) : `Play ${g.title} for free in your browser on Pixuvo. No downloads.`;
const portrait = g.orientation === 'portrait' || (!!g.width && !!g.height && g.height > g.width * 1.1);
const votes = g.ratingUp + g.ratingDown;
const liked = votes >= 5 ? Math.round((g.ratingUp / votes) * 100) : null; // shown only with ≥ 5 real votes
const players = g.players ? (g.players >= 2 ? `${g.players}+ players` : '1 player') : null;
const styleLabel = g.visualStyle === 'pixel' ? 'Pixel art' : g.visualStyle?.toUpperCase() ?? null;
const controls = parseControls(g.instructions);
const tones = ['violet', 'blue', 'teal', 'orange', 'pink', 'green'] as const;
const sideList = g.related.slice(0, 5);
const moreCat = g.related.slice(5, 11);
const similar = g.related.slice(11, 17);
const topCat = g.related.slice(17, 23);
const devices = g.mobile ? 'Desktop, Mobile, Tablet' : 'Desktop';
const ld = [{
  '@context': 'https://schema.org', '@type': 'VideoGame', name: g.title, url: canonical(path), image: g.thumb,
  ...(g.description ? { description: truncate(g.description, 500) } : {}),
  genre: g.categories.filter((c) => c.slug !== '2-player' && c.slug !== 'multiplayer').map((c) => c.name).slice(0, 4),
  gamePlatform: 'Web browser', applicationCategory: 'Game', operatingSystem: 'Any',
  playMode: g.players && g.players >= 2 ? 'MultiPlayer' : g.players === 1 ? 'SinglePlayer' : undefined,
  ...(g.releaseDate ? { datePublished: g.releaseDate } : {}),
  offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD' },
}];
const data = { id: g.id, slug: g.slug, title: g.title, thumb: g.thumb, portrait, ...(cat ? { cat: cat.slug } : {}) };
---
<Base title={`${g.title} – Play Free Online`} description={desc} path={path} ogImage={g.thumb} jsonLd={ld}>
  <div class="wrap">
    <Breadcrumbs items={crumbs} />
    <div class="game-layout">
      <div class="game-main">
        <header class="game-head">
          <img class="game-icon" src={g.thumb} alt="" width="76" height="76" referrerpolicy="no-referrer" />
          <div class="game-head-text">
            <h1>{g.title}</h1>
            <p class="game-rating">
              {liked !== null
                ? <><span class="liked-ico" aria-hidden="true">👍</span><strong>{liked}% liked</strong> <span>({plural(votes, 'vote')} on Pixuvo)</span></>
                : <span class="muted">Not rated yet</span>}
            </p>
          </div>
          <div class="game-tags">{g.categories.slice(0, 3).map((c, i) => <Tag href={categoryPath(c.slug)} tone={tones[i % tones.length]!}>{c.name}</Tag>)}</div>
        </header>

        <div class:list={['stage', { portrait }]} id="stage" data-game={JSON.stringify(data)}>
          <div class="stage-poster" data-poster>
            <img class="bg" src={g.thumb} alt="" width="320" height="240" referrerpolicy="no-referrer" />
            <div class="inner">
              <img class="cover" src={g.thumb} alt={`${g.title} cover image`} width="320" height="240" fetchpriority="high" referrerpolicy="no-referrer" />
              <button type="button" class="play-btn" data-play><Icon name="play" /> Play Now</button>
              <p class="stage-msg" data-stage-msg>No download required • Play instantly in your browser</p>
            </div>
          </div>
        </div>
        <button type="button" class="btn btn-primary exit-expanded" data-exit-expanded><Icon name="x" size={18} /> Exit</button>
        <div class="game-actions" aria-label="Game actions">
          <button type="button" class="action-btn" data-fav={g.id} data-slug={g.slug} data-title={g.title} data-thumb={g.thumb} aria-pressed="false" data-fav-label="static"><Icon name="heart" size={20} /> <span>Add to Favorites</span></button>
          <button type="button" class="action-btn" data-fullscreen><Icon name="maximize" size={20} /> <span>Fullscreen</span></button>
          <button type="button" class="action-btn" data-share><Icon name="share" size={20} /> <span>Share</span></button>
          <button type="button" class="action-btn" data-report-open><Icon name="flag" size={20} /> <span>Report Issue</span></button>
        </div>
        <p class="note" data-share-status aria-live="polite"></p>

        <section class="panel" aria-labelledby="about-h">
          <h2 id="about-h"><span class="panel-ico" aria-hidden="true">📄</span>About {g.title}</h2>
          {g.description ? <div class="prose"><p>{g.description}</p></div> : <p class="note">The publisher has not provided a description for this game yet.</p>}
          <div class="tag-row">
            {g.categories.map((c, i) => <Tag href={categoryPath(c.slug)} tone={tones[i % tones.length]!} small>{c.name}</Tag>)}
            {styleLabel && <Tag tone="orange" small>{styleLabel}</Tag>}
            {g.controls.map((c) => <Tag tone="pink" small>{c[0]!.toUpperCase() + c.slice(1)}</Tag>)}
          </div>
        </section>

        {(g.instructions || controls.length > 0) && (
          <div class="howto-row">
            {g.instructions && (
              <section class="panel" aria-labelledby="howto-h">
                <h2 id="howto-h"><span class="panel-ico" aria-hidden="true">🎮</span>How to Play</h2>
                <div class="prose"><p>{g.instructions}</p></div>
              </section>
            )}
            {controls.length > 0 && (
              <section class="panel" aria-labelledby="controls-h">
                <h2 id="controls-h"><span class="panel-ico" aria-hidden="true">⚙️</span>Controls</h2>
                <ControlsVisual rows={controls} />
              </section>
            )}
          </div>
        )}
      </div>

      <aside class="game-side">
        {sideList.length > 0 && (
          <section class="panel" aria-labelledby="recg-h">
            <div class="panel-head"><h2 id="recg-h">Recommended Games</h2>{cat && <a href={categoryPath(cat.slug)}>See all</a>}</div>
            <RecommendedList games={sideList} />
          </section>
        )}
        <section class="panel" aria-labelledby="facts-h">
          <h2 id="facts-h"><span class="panel-ico" aria-hidden="true">ℹ️</span>Game Details</h2>
          <dl class="facts">
            {cat && (<><dt>Category</dt><dd><a href={categoryPath(cat.slug)}><img src={categoryIcon(cat.slug)} alt="" width="20" height="20" />{cat.name}</a></dd></>)}
            {players && (<><dt>Players</dt><dd>{players}</dd></>)}
            {g.releaseDate && (<><dt>Released</dt><dd>{fmtDate(g.releaseDate)}</dd></>)}
            <dt>Platform</dt><dd>Web browser</dd>
            {g.technology && (<><dt>Technology</dt><dd>{g.technology === 'html5' ? 'HTML5' : g.technology === 'webgl' ? 'WebGL' : 'Unity'}</dd></>)}
            <dt>Devices</dt><dd>{devices}{!g.mobile && <span class="note"> (mobile not stated)</span>}</dd>
            {styleLabel && (<><dt>Style</dt><dd>{styleLabel}</dd></>)}
            <dt>Added</dt><dd>{fmtDate(g.addedAt)}</dd>
            {g.providerName && (<><dt>Provider</dt><dd>{g.providerName}</dd></>)}
          </dl>
        </section>
        <section class="panel" aria-labelledby="rate-h">
          <h2 id="rate-h">Did you like it?</h2>
          <div class="rating" data-rating data-up={g.ratingUp} data-down={g.ratingDown}>
            <button type="button" class="action-btn" data-vote="1" aria-pressed="false"><Icon name="up" size={20} /> <span>Like</span></button>
            <button type="button" class="action-btn" data-vote="-1" aria-pressed="false"><Icon name="down" size={20} /> <span>Dislike</span></button>
          </div>
          <p class="score" data-score>{votes > 0 ? `${Math.round((g.ratingUp / votes) * 100)}% liked · ${plural(votes, 'vote')} on Pixuvo` : 'Not rated yet — be the first!'}</p>
          <div data-turnstile-slot></div>
          <p class="form-status" data-rate-status aria-live="polite"></p>
        </section>
        <AdSlot slot="game-sidebar" />
      </aside>
    </div>

    {moreCat.length > 0 && cat && (
      <section class="section strip" aria-labelledby="more-h">
        <div class="section-head"><h2 id="more-h"><img src={categoryIcon(cat.slug)} alt="" width="30" height="30" loading="lazy" />More {cat.name} Games</h2><a href={categoryPath(cat.slug)}>See all</a></div>
        <GameGrid games={moreCat} label={`More ${cat.name} games`} />
      </section>
    )}
    {(similar.length > 0 || topCat.length > 0) && (
      <div class="split">
        {similar.length > 0 && (
          <section class="section" aria-labelledby="sim-h">
            <div class="section-head"><h2 id="sim-h"><img src="/icons/cat/ui-controller.webp" alt="" width="28" height="28" loading="lazy" />Similar Games</h2></div>
            <GameGrid games={similar} label="Similar games" compact />
          </section>
        )}
        {topCat.length > 0 && cat && (
          <section class="section" aria-labelledby="top-h">
            <div class="section-head"><h2 id="top-h"><img src="/icons/cat/ui-popular.webp" alt="" width="28" height="28" loading="lazy" />Top {cat.name} Games</h2><a href={categoryPath(cat.slug)}>See all</a></div>
            <GameGrid games={topCat} label={`Top ${cat.name} games`} compact />
          </section>
        )}
      </div>
    )}
  </div>

  <dialog id="report-dialog" aria-labelledby="report-h">
    <form method="dialog" data-report-form>
      <h2 id="report-h">Report a problem</h2>
      <p class="note" style="margin:0">Tell us what is wrong with <strong>{g.title}</strong>. We read every report.</p>
      <label class="field">What happened?
        <select name="reason" required>
          <option value="not_loading">The game does not load</option>
          <option value="broken_controls">Controls do not work</option>
          <option value="inappropriate">Inappropriate content</option>
          <option value="copyright">Copyright or trademark problem</option>
          <option value="other">Something else</option>
        </select>
      </label>
      <label class="field">Details (optional)
        <textarea name="message" maxlength="1000" placeholder="Browser, device, what you saw…"></textarea>
      </label>
      <div data-turnstile-slot></div>
      <p class="form-status" data-report-status aria-live="polite"></p>
      <div style="display:flex;gap:8px;justify-content:flex-end">
        <button type="button" class="btn btn-ghost" data-report-cancel>Cancel</button>
        <button type="submit" class="btn btn-primary" value="send">Send report</button>
      </div>
      <p class="note" style="margin:0">For legal notices see <a href="/copyright/">Copyright</a>.</p>
    </form>
  </dialog>
</Base>
<script>
  import '../scripts/player';
</script>
