---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
const path = Astro.url.pathname;
const nav = [
  { href: '/categories/', label: 'Categories' },
  { href: '/new-games/', label: 'New' },
  { href: '/popular-games/', label: 'Popular' },
  { href: '/2-player-games/', label: '2 Player' },
  { href: '/multiplayer-games/', label: 'Multiplayer' },
];
const q = Astro.props.query ?? '';
interface Props { query?: string | undefined }
---
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap header-row">
    <Logo />
    <form class="header-search" action="/search/" method="get" role="search" data-search>
      <label class="sr-only" for="site-search">Search games</label>
      <div class="search-field">
        <input id="site-search" name="q" type="search" value={q} placeholder="Search games" autocomplete="off" spellcheck="false"
          maxlength="80" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="search-suggest" enterkeyhint="search" data-search-input />
        <button type="submit" aria-label="Search"><Icon name="search" size={18} /></button>
      </div>
      <ul id="search-suggest" class="suggest" role="listbox" aria-label="Suggestions" hidden></ul>
      <p class="sr-only" aria-live="polite" data-search-status></p>
    </form>
    <nav class="main-nav" aria-label="Main">
      {nav.map((n) => <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>)}
      <a href="/favorites/" class="nav-fav" aria-current={path === '/favorites/' ? 'page' : undefined}><Icon name="heart" size={18} />Favorites</a>
    </nav>
    <button type="button" class="icon-btn menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="nav-drawer" data-drawer-open="nav-drawer">
      <Icon name="menu" />
    </button>
  </div>
</header>
<div class="drawer" id="nav-drawer" data-drawer aria-hidden="true">
  <div class="drawer-backdrop" data-drawer-close></div>
  <div class="drawer-panel" role="dialog" aria-modal="true" aria-label="Menu">
    <div class="drawer-head">Menu <button type="button" class="icon-btn" aria-label="Close menu" data-drawer-close><Icon name="x" /></button></div>
    <nav class="drawer-nav" aria-label="Mobile">
      <a href="/">Home</a>
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      <a href="/favorites/">Favorites</a>
      <a href="/recently-played/">Recently played</a>
      <a href="/games/">All games</a>
      <a href="/trending-games/">Trending</a>
    </nav>
  </div>
</div>
<script>
  import '../scripts/search';
  import '../scripts/drawer';
</script>
