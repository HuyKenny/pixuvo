---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';
import { uiIcon } from '../lib/category-icons';
import { useI18n } from '../i18n';
import { stripLocale } from '../i18n/locales';
const { t } = await useI18n(Astro);
const path = stripLocale(Astro.url.pathname);
const nav = [
  { href: '/categories/', label: t('nav.categories'), icon: uiIcon('grid') },
  { href: '/new-games/', label: t('nav.new'), icon: uiIcon('lightning') },
  { href: '/popular-games/', label: t('nav.popular'), icon: uiIcon('popular') },
  { href: '/2-player-games/', label: t('nav.twoPlayer'), icon: uiIcon('two') },
  { href: '/favorites/', label: t('nav.favorites'), icon: uiIcon('heart') },
];
const q = Astro.props.query ?? '';
interface Props { query?: string | undefined }
---
<a class="skip-link" href="#main">{t('a11y.skip')}</a>
<header class="site-header">
  <div class="wrap header-row">
    <Logo />
    <form class="header-search" action="/search/" method="get" role="search" data-search>
      <label class="sr-only" for="site-search">{t('search.label')}</label>
      <div class="search-field">
        <input id="site-search" name="q" type="search" value={q} placeholder={t('search.placeholder')} autocomplete="off" spellcheck="false"
          maxlength="80" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="search-suggest" enterkeyhint="search" data-search-input />
        <button type="submit" aria-label={t('search.submit')}><Icon name="search" size={20} /></button>
      </div>
      <ul id="search-suggest" class="suggest" role="listbox" aria-label={t('search.suggestions')} hidden></ul>
      <p class="sr-only" aria-live="polite" data-search-status></p>
    </form>
    <nav class="main-nav" aria-label={t('a11y.mainNav')}>
      {nav.map((n) => <a href={n.href} aria-current={path === n.href ? 'page' : undefined}><img src={n.icon} alt="" width="22" height="22" />{n.label}</a>)}
    </nav>
    <LangSwitch variant="header" />
    <button type="button" class="icon-btn menu-btn" aria-label={t('nav.openMenu')} aria-expanded="false" aria-controls="nav-drawer" data-drawer-open="nav-drawer">
      <Icon name="menu" />
    </button>
  </div>
</header>
<div class="drawer" id="nav-drawer" data-drawer aria-hidden="true">
  <div class="drawer-backdrop" data-drawer-close></div>
  <div class="drawer-panel" role="dialog" aria-modal="true" aria-label={t('nav.menu')}>
    <div class="drawer-head">{t('nav.menu')} <button type="button" class="icon-btn" aria-label={t('nav.closeMenu')} data-drawer-close><Icon name="x" /></button></div>
    <nav class="drawer-nav" aria-label={t('a11y.mobileNav')}>
      <a href="/"><img src={uiIcon('controller')} alt="" width="26" height="26" />{t('nav.home')}</a>
      {nav.map((n) => <a href={n.href}><img src={n.icon} alt="" width="26" height="26" />{n.label}</a>)}
      <a href="/recently-played/"><img src={uiIcon('clock')} alt="" width="26" height="26" />{t('nav.recentlyPlayed')}</a>
      <a href="/games/"><img src={uiIcon('star')} alt="" width="26" height="26" />{t('nav.allGames')}</a>
      <a href="/random/" rel="nofollow"><span class="drawer-emoji" aria-hidden="true">🎲</span>{t('nav.random')}</a>
      <a href="/parents/"><span class="drawer-emoji" aria-hidden="true">👪</span>{t('nav.parents')}</a>
    </nav>
    <div class="drawer-lang"><LangSwitch variant="footer" /></div>
  </div>
</div>
<script>
  import '../scripts/search';
  import '../scripts/drawer';
</script>
