---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { uiIcon } from '../lib/category-icons';
const path = Astro.url.pathname;
const nav = [
  { href: '/categories/', label: 'Categories', icon: uiIcon('grid') },
  { href: '/new-games/', label: 'New', icon: uiIcon('lightning') },
  { href: '/popular-games/', label: 'Popular', icon: uiIcon('popular') },
  { href: '/2-player-games/', label: '2 Player', icon: uiIcon('two') },
  { href: '/favorites/', label: 'Favorites', icon: uiIcon('heart') },
];
const q = Astro.props.query ?? '';
interface Props { query?: string | undefined }
---
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap header-row">
    <Logo />
    <form class="header-search" action="/search/" method="get" role="search" data-search>
      <label class="sr-only" for="site-search">Search games</label>
      <div class="search-field">
        <input id="site-search" name="q" type="search" value={q} placeholder="Search games, categories…" autocomplete="off" spellcheck="false"
          maxlength="80" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="search-suggest" enterkeyhint="search" data-search-input />
        <button type="submit" aria-label="Search"><Icon name="search" size={20} /></button>
      </div>
      <ul id="search-suggest" class="suggest" role="listbox" aria-label="Suggestions" hidden></ul>
      <p class="sr-only" aria-live="polite" data-search-status></p>
    </form>
    <nav class="main-nav" aria-label="Main">
      {nav.map((n) => <a href={n.href} aria-current={path === n.href ? 'page' : undefined}><img src={n.icon} alt="" width="22" height="22" />{n.label}</a>)}
    </nav>
    <button type="button" class="icon-btn menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="nav-drawer" data-drawer-open="nav-drawer">
      <Icon name="menu" />
    </button>
  </div>
</header>
<div class="drawer" id="nav-drawer" data-drawer aria-hidden="true">
  <div class="drawer-backdrop" data-drawer-close></div>
  <div class="drawer-panel" role="dialog" aria-modal="true" aria-label="Menu">
    <div class="drawer-head">Menu <button type="button" class="icon-btn" aria-label="Close menu" data-drawer-close><Icon name="x" /></button></div>
    <nav class="drawer-nav" aria-label="Mobile">
      <a href="/"><img src={uiIcon('controller')} alt="" width="26" height="26" />Home</a>
      {nav.map((n) => <a href={n.href}><img src={n.icon} alt="" width="26" height="26" />{n.label}</a>)}
      <a href="/recently-played/"><img src={uiIcon('clock')} alt="" width="26" height="26" />Recently played</a>
      <a href="/games/"><img src={uiIcon('star')} alt="" width="26" height="26" />All games</a>
      <a href="/random/" rel="nofollow"><span class="drawer-emoji" aria-hidden="true">🎲</span>Random game</a>
      <a href="/parents/"><span class="drawer-emoji" aria-hidden="true">👪</span>For parents</a>
    </nav>
  </div>
</div>
<script>
  import '../scripts/search';
  import '../scripts/drawer';
</script>
