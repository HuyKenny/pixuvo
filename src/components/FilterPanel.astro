---
/**
 * "Find your game": search inside the list, quick chips and a filter sheet.
 * State lives in the URL fragment (src/scripts/filters.ts). Option counts come from
 * /data/facets.json (written by the snapshot), so options with too few games are hidden.
 */
import Icon from './Icon.astro';
import { categoryIcon } from '../lib/category-icons';
import { categoryPath } from '../lib/site';
import { useI18n } from '../i18n';
interface Props {
  category: string | null;
  name: string;
  total: number;
  /** Subcategory chips (filter in place; plain links without JS). */
  subs?: Array<{ slug: string; name: string; count: number }>;
  /** Link chips shown when there is no category (e.g. genres on /games/). */
  links?: Array<{ slug: string; name: string }>;
}
const { category, name, total, subs = [], links = [] } = Astro.props;
const i = await useI18n(Astro);
const t = i.t;
const gv = category ? i.catGames(category, name) : { games: name, gamesLc: name };
---
<div class="finder" data-filters data-category={category ?? ''} data-total={total} data-subs={JSON.stringify(subs.map((s) => ({ slug: s.slug, name: s.name })))}>
  <form class="finder-search" role="search" data-filter-search>
    <label class="sr-only" for="finder-q">{t('filter.searchIn', gv)}</label>
    <Icon name="search" size={20} />
    <input id="finder-q" type="search" name="q" placeholder={t('filter.searchInPlaceholder', gv)} maxlength="60" autocomplete="off" enterkeyhint="search" />
    <button type="button" class="finder-clear" data-filter-qclear hidden aria-label={t('filter.clearSearch')}><Icon name="x" size={18} /></button>
  </form>
  <div class="finder-chips" role="group" aria-label={t('a11y.quickFilters')}>
    <button type="button" class="qchip qchip-main" data-drawer-open="filter-drawer" aria-controls="filter-drawer" aria-expanded="false">
      <Icon name="filter" size={18} /> {t('filter.filters')} <span class="qchip-badge" data-filter-badge hidden></span>
    </button>
    <button type="button" class="qchip" data-drawer-open="filter-drawer" aria-controls="filter-drawer" aria-expanded="false">
      {t('filter.sort')} <strong data-sort-label>{t('c.sortBest')}</strong> <span aria-hidden="true">▾</span>
    </button>
    {subs.map((s) => (
      <a class="qchip" href={categoryPath(s.slug)} data-quick="sub" data-value={s.slug}>
        <img src={categoryIcon(s.slug)} alt="" width="26" height="26" loading="lazy" />{s.name}<small>{i.approx(s.count)}</small>
      </a>
    ))}
    <button type="button" class="qchip" data-quick="players" data-value="2" aria-pressed="false" hidden><span aria-hidden="true">👥</span>{t('home.quick2p')}</button>
    <button type="button" class="qchip" data-quick="device" data-value="mobile" aria-pressed="false" hidden><span aria-hidden="true">📱</span>{t('home.quickMobile')}</button>
    {links.map((l) => (
      <a class="qchip" href={categoryPath(l.slug)}><img src={categoryIcon(l.slug)} alt="" width="26" height="26" loading="lazy" />{l.name}</a>
    ))}
  </div>
  <div class="finder-status">
    <span class="result-count" aria-live="polite" data-result-count>{t('c.games', { n: total })}</span>
    <div class="active-filters" data-active-filters></div>
  </div>
</div>
<div class="drawer drawer-sheet" id="filter-drawer" data-drawer aria-hidden="true">
  <div class="drawer-backdrop" data-drawer-close></div>
  <div class="drawer-panel" role="dialog" aria-modal="true" aria-labelledby="filter-title">
    <div class="sheet-grip" aria-hidden="true"></div>
    <div class="drawer-head"><span id="filter-title">{t('filter.title')}</span><button type="button" class="icon-btn" aria-label={t('filter.close')} data-drawer-close><Icon name="x" /></button></div>
    <form class="filter-form" data-filter-form>
      <div data-filter-groups></div>
      <div class="drawer-foot">
        <button type="button" class="btn btn-ghost" data-filter-clear>{t('filter.clearAll')}</button>
        <button type="button" class="btn btn-primary" data-drawer-close data-show-count>{t('filter.showGames')}</button>
      </div>
    </form>
  </div>
</div>
<noscript><p class="note">{t('filter.noscript')}</p></noscript>
<script>
  import '../scripts/filters';
</script>
