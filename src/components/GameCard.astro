---
import type { GameCard } from '../lib/types';
import { gamePath } from '../lib/site';
import Icon from './Icon.astro';
import { cardBadge } from '../lib/plays';
import { useI18n } from '../i18n';
interface Props { game: GameCard; eager?: boolean; badge?: string | undefined }
const { game, eager = false, badge: given } = Astro.props;
const i = await useI18n(Astro);
const badge = given ?? cardBadge(game, i.t);
const catName = game.cat ? i.cat(game.catSlug ?? '', game.cat) : null;
const meta = [catName, game.players && game.players >= 2 ? i.t('card.players', { n: game.players }) : null].filter(Boolean).join(' · ');
---
<article class="card" data-game-id={game.id}>
  <a class="card-link" href={gamePath(game.slug)}>
    <span class="card-media">
      <img class="card-thumb" src={game.thumb} alt="" width="320" height="240" loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : 'auto'} referrerpolicy="no-referrer" />
      <span class="card-play" aria-hidden="true"><Icon name="play" size={22} /></span>
      {badge && <span class="card-badge">{badge}</span>}
    </span>
    <span class="card-body">
      <span class="card-title">{game.title}</span>
      {meta && <span class="card-meta">{meta}</span>}
    </span>
  </a>
  <button type="button" class="fav-btn" data-fav={game.id} data-slug={game.slug} data-title={game.title} data-thumb={game.thumb} aria-pressed="false" aria-label={i.t('card.addFav', { title: game.title })}>
    <Icon name="heart" />
  </button>
</article>
