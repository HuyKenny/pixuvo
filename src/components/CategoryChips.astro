---
import type { CategoryInfo } from '../lib/types';
import { categoryPath } from '../lib/site';
import { useI18n } from '../i18n';
const i = await useI18n(Astro);
interface Props { categories: CategoryInfo[]; current?: string; label?: string }
const { categories, current, label = i.t('a11y.gameCategories') } = Astro.props;
---
<nav aria-label={label}><div class="chips">
  {categories.map((c) => <a class="chip" href={categoryPath(c.slug)} aria-current={c.slug === current ? 'page' : undefined}>{i.cat(c.slug, c.name)}</a>)}
  <a class="chip" href="/categories/">{i.t('nav.allCategories')}</a>
</div></nav>
