---
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
interface Props { kind: 'favorites' | 'recent' }
import { useI18n } from '../i18n';
const { kind } = Astro.props;
const { t } = await useI18n(Astro);
const fav = kind === 'favorites';
const name = fav ? t('personal.favorites') : t('personal.recent');
const path = fav ? '/favorites/' : '/recently-played/';
---
<Base title={name} description={fav ? t('personal.favDescription') : t('personal.recentDescription')} path={null} noindex>
  <div class="wrap">
    <Breadcrumbs items={[{ name: t('nav.home'), href: '/' }, { name, href: path }]} />
    <div class="page-head">
      <h1>{name}</h1>
      <p class="lead">{fav ? t('personal.favLead') : t('personal.recentLead')}</p>
    </div>
    <div class="filter-bar">
      <span class="result-count" data-count aria-live="polite"></span>
      <button type="button" class="btn btn-ghost btn-sm" data-clear hidden>{fav ? t('personal.clearFav') : t('personal.clearRecent')}</button>
    </div>
    <p class="note" data-unavailable hidden>{fav ? t('personal.unavailableFav') : t('personal.unavailableRecent')}</p>
    <div class="grid" id="personal-grid" role="list" aria-label={name} data-kind={kind}></div>
    <div class="empty-state" data-empty hidden><strong>{fav ? t('personal.emptyFavTitle') : t('personal.emptyRecentTitle')}</strong>{fav ? t('personal.emptyFavText') : t('personal.emptyRecentText')} <a href="/">{t('personal.findGame')}</a></div>
  </div>
</Base>
<script>
  import { store } from '../scripts/store';
  import { cardHtml } from '../scripts/cards';
  import { tr } from '../scripts/i18n';
  const grid = document.getElementById('personal-grid')!;
  const kind = grid.dataset.kind as 'favorites' | 'recent';
  const label = kind === 'favorites' ? tr('c.listFavorites') : tr('c.listHistory');
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const clear = document.querySelector<HTMLButtonElement>('[data-clear]')!;
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  if (!store.available()) document.querySelector<HTMLElement>('[data-unavailable]')!.hidden = false;
  const draw = () => {
    const items = kind === 'favorites' ? store.favorites() : store.recent();
    grid.innerHTML = items.map((g) => cardHtml(g, { removable: label })).join('');
    empty.hidden = items.length > 0;
    clear.hidden = items.length === 0;
    count.textContent = items.length ? tr('c.games', { n: items.length }) : '';
  };
  grid.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('[data-remove]');
    if (!b) return;
    e.preventDefault();
    const id = Number(b.dataset.remove);
    if (kind === 'favorites') store.removeFavorite(id);
    else store.removeRecent(id);
    count.focus?.();
  });
  clear.addEventListener('click', () => {
    if (kind === 'favorites') store.clearFavorites();
    else store.clearRecent();
  });
  store.subscribe(draw);
  draw();
</script>
