---
/** Homepage filter panel: every option is a plain link to /games/ with fragment filters (nothing crawlable). */
import type { CategoryInfo } from '../lib/types';
import { categoryIcon } from '../lib/category-icons';
import { categoryPath } from '../lib/site';
interface Props { genres: CategoryInfo[] }
const { genres } = Astro.props;
import { useI18n } from '../i18n';
const i = await useI18n(Astro);
const t = i.t;
const groups = [
  { title: t('home.players'), opts: [['players=1', '👤', t('home.p1')], ['players=2', '👥', t('home.p2')], ['mode=online', '🌐', t('home.online')]] },
  { title: t('home.device'), opts: [['device=mobile', '📱', t('home.quickMobile')]] },
  { title: t('home.controls'), opts: [['controls=keyboard', '⌨️', t('home.keyboard')], ['controls=mouse', '🖱️', t('home.quickMouse')], ['controls=touch', '👆', t('home.quickTouch')]] },
  { title: t('home.style'), opts: [['style=2d', '🟦', '2D'], ['style=3d', '🧊', '3D'], ['style=pixel', '👾', t('home.pixel')]] },
];
---
<aside class="filterside" aria-label={t('home.findGame')}>
  {/* Not headings: this sidebar comes before the page's H1 in the source. */}
  <p class="fs-title">{t('home.findGame')}</p>
  <p class="fs-group">{t('home.genre')}</p>
  <ul>{genres.map((g) => <li><a href={categoryPath(g.slug)}><img src={categoryIcon(g.slug)} alt="" width="22" height="22" loading="lazy" />{i.cat(g.slug, g.name)}</a></li>)}</ul>
  {groups.map((g) => (
    <>
      <p class="fs-group">{g.title}</p>
      <ul>{g.opts.map(([frag, emoji, label]) => <li><a href={`/games/#${frag}`}><span class="fs-emoji" aria-hidden="true">{emoji}</span>{label}</a></li>)}</ul>
    </>
  ))}
</aside>
