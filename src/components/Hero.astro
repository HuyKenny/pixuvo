---
import Mascot from './Mascot.astro';
import Icon from './Icon.astro';
import { useI18n } from '../i18n';
import type { GameCard } from '../lib/types';
interface Props { total: number; picks: GameCard[] }
const { total, picks } = Astro.props;
const first = picks[0];
const { t, approx } = await useI18n(Astro);
---
<section class="hero" aria-labelledby="hero-h">
  <div class="hero-text">
    <h1 id="hero-h">{t('home.heroTitleA', { count: approx(total) })} <span>{t('home.heroTitleB')}</span></h1>
    <p>{t('home.heroText')}</p>
    {first && (
      <a class="btn-hero" href={`/games/${first.slug}/`} data-random-game={JSON.stringify(picks.map((g) => g.slug))}>
        <Icon name="play" size={22} /> {t('home.startPlaying')}
      </a>
    )}
    <ul class="hero-checks">
      <li>{t('home.check1')}</li><li>{t('home.check2')}</li><li>{t('home.check3')}</li><li>{t('home.check4')}</li>
    </ul>
  </div>
  <Mascot class="hero-mascot" />
</section>
<script>
  // "Start Playing" opens a different featured game each time.
  for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-random-game]')) {
    try {
      const list = JSON.parse(a.dataset.randomGame ?? '[]') as string[];
      if (list.length) a.href = `${document.documentElement.dataset.lp ?? ''}/games/${list[Math.floor(Math.random() * list.length)]}/`;
    } catch {
      /* keep the server link */
    }
  }
</script>
