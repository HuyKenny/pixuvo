---
/** Desktop filter column (≥ 1180px), same groups as the phone sheet — rendered by src/scripts/filters.ts. */
---
<aside class="filterside list-side" aria-labelledby="side-filter-h">
  <div class="side-head"><h2 id="side-filter-h">Find a game</h2><button type="button" class="link-btn" data-filter-clear>Reset</button></div>
  <form class="filter-form side-form" data-filter-form>
    <div data-filter-groups><p class="note">Loading filters…</p></div>
  </form>
</aside>
