---
import { approxCount } from '../lib/format';
import { uiIcon } from '../lib/category-icons';
interface Props { games: number; categories: number; playsYesterday?: number }
const { games, categories, playsYesterday = 0 } = Astro.props;
// Real game starts yesterday (each visitor counts once per game); shown only when it is a meaningful number.
const played = playsYesterday >= 50;
const items = [
  { icon: uiIcon('controller'), big: `${approxCount(games)}`, small: 'Games', note: 'and counting' },
  { icon: uiIcon('grid'), big: `${categories}`, small: 'Categories', note: 'something for everyone' },
  played
    ? { icon: uiIcon('lightning'), big: playsYesterday.toLocaleString('en-US'), small: 'Plays', note: 'yesterday on Pixuvo' }
    : { icon: uiIcon('lightning'), big: 'Play', small: 'Instantly', note: 'starts in one click' },
  { icon: uiIcon('cloud'), big: 'No', small: 'Download', note: 'works in your browser' },
];
---
<ul class="statcards" aria-label="Why Pixuvo">
  {items.map((i) => <li><img src={i.icon} alt="" width="44" height="44" /><span><strong>{i.big} <em>{i.small}</em></strong><small>{i.note}</small></span></li>)}
</ul>
